# Dedicated Rahat Energy project only. Never commit a populated .env.
ENERGY_DATABASE_URL=
ENERGY_DIRECT_URL=
ENERGY_SUPABASE_PROJECT_REF=
# Store owner sign-in password (1–128 characters).
ENERGY_ADMIN_PASSWORD=
# At least 32 random characters.
ENERGY_ADMIN_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Use test with sk_test_ or live with sk_live_.
ENERGY_PAYSTACK_MODE=live
ENERGY_PAYSTACK_SECRET_KEY=
# Mode-specific webhook signing secret from Paystack API configuration (whsec_...).
ENERGY_PAYSTACK_WEBHOOK_SECRET=
ENERGY_RESEND_API_KEY=
ENERGY_EMAIL_FROM=
# Store owner sign-in email.
ENERGY_ADMIN_EMAIL=
ENERGY_CRON_SECRET=
# Disposable localhost database ending in _test; never use a production URL.
ENERGY_TEST_DATABASE_URL=
# Sales inbox for quote requests and customer replies. Replace this placeholder.
ENERGY_SALES_EMAIL=sales@example.invalid
